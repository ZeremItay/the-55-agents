# ============================================
# קובץ דוגמה למשתני סביבה
# העתק לקובץ .env ומלא ערכים אמיתיים
# cp .env.example .env
# ============================================

# Anthropic API — למקרה שסוכן מבצע קריאות ישירות ל-Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google / Gemini API — לשימוש Nano Banana (יצירת תמונות עבור יובל)
GEMINI_API_KEY=your_gemini_api_key_here

# מפתחות חיפוש ומחקר — לשימוש חן (החוקרת)
# Tavily / Perplexity / Brave Search וכו'
TAVILY_API_KEY=your_tavily_api_key_here

# OpenAI — אופציונלי, למקרה שמשתמשים במודלים נוספים
OPENAI_API_KEY=your_openai_api_key_here
